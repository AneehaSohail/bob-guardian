default"},{"gate":"1326334369","gateValue":"true","ruleID":"6XNtx5BnDu95sYciBN1U9z:100.00:9"},{"gate":"957497898","gateValue":"false","ruleID":"Bg20Kw8ydPcademg0qKQq:5.00:1"},{"gate":"1833787017","gateValue":"false","ruleID":"default"}],"version":621,"id_type":"userID","value":{"max_active_automations":5,"max_iterations_per_hour":1,"fiber_generic_chatgpt_builtin_tool_references":[{"tool_type":"ToolRef","tool_id":"automations"},{"tool_type":"ToolRef","tool_id":"image_gen"}],"fiber_tool_call_elicitation_mode":"elicit_on_writes","override_default_tools":false,"exact_schedule_proactive_start_offset_seconds":10,"bypass_chat_model_output":true,"automations_create_tool_additional_guidance":"Do NOT mention the automation id to the user in  your response.","slack_webhook_bot_membership_message_template":"I couldn't create an immediate Slack monitor because @ChatGPT isn't in {channel}. I can still set up an hourly monitor right now, or you can install or reconnect the [ChatGPT Slack app](https://chatgpt.com/slack-ai-app-install), add @ChatGPT to the channel, and try again for immediate notifications. Which would you like?","enable_whisper":false,"fiber_sync_hazelnut_skills_to_workspace":false,"legacy_completion_prompt":"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \n\nExamples for when to output `::SKIP_COMPLETION::`:\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run\n\nThe `::SKIP_COMPLETION::` logic should only apply to this turn. This guidance is no longer applicable after the next user turn.","max_messages_per_conversation":1000,"private_peek_enabled":true,"automations_list_tool_additional_guidance":"The UI will already render the user's active automations from this list result. The automations will be rendered below your response Do NOT restate active automations in prose unless adding information not already visible to the user. Do not tell the user about any automations with enabled = false. They are considered deleted. You do not need to mention the UI either. Simply summarize in 1 sentence or less what automations exist.\n\nDo not call the automations `list` action again this turn; use the automations `peek` action for any further inspection.","skip_completion_text":"::SKIP_COMPLETION::","enable_file_export":true,"general_agent_invoked_system_hints":[],"enable_browser_tool":true,"tool_model_instructions":"","automations_create_plan_tool_additional_guidance":"The user has created an automation for an ongoing goal with a private plan. Collaborate with the user across turns, use available structured context to understand their goals and prior progress, and help advance the saved plan.","webhook_trigger_user_prompt_template":"{automation_prompt}\n\nThis run was triggered by a webhook event. Use the event below as the new information to evaluate for this run.\nWebhook family: {family}\nWebhook event:\n{normalized_event_json}","validate_automation_prompt_template":"","exact_schedule_jitter_radius_seconds":300,"max_turns_per_conversation":175,"break_plugin_service_brte_history_chain":true,"active_task_limit_message_template":"You've reached your limit of {active_limit} active tasks. To schedule more tasks, consider pausing some tasks or upgrading your plan.","condition_watch_jitter_radius_seconds":600,"fiber_use_generic_chatgpt_builtin_tools":true,"gaas_extra_features":{"multi_agent":true,"fast_mode":true},"automations_list_limit":25,"json_completion_prompt":"Complete the automation's work on every run, whether or not there is an update to send.\nUse the user's instructions to decide whether this run warrants notifying them, including\nrequested reminders and meaningful findings or changes.\n\nWhen the user should be notified, write your normal final response.\nWhen no notification is needed but the response should appear in the user's conversation history,\nmake your entire final response this JSON object with exactly these fields:\n{\"type\": \"skip_notification\", \"reason\": \"Your full response to the task\"}.\nWhen there is no useful update to add to the user's conversation history, omit reason and make your\nentire final response {\"type\": \"skip_notification\"}. Do not wrap the JSON in a code fence or add\ntext outside it.\n\nWrite reason as a fully natural assistant response addressed to the user. Include the useful\nfindings, details of the work you did, and relevant limitations or next steps, with the same\ndetail you would normally provide for the task. This response remains available in the run's\nhistory. It does not need to justify skipping a notification or discuss notification mechanics.\nUse normal prose and Markdown within the JSON string, escaping it as valid JSON.","model_lane_override":"auto","additional_developer_message_prompt":"If you do not have an update for the user during this automation turn, you must emit `::SKIP_COMPLETION::`. UNLESS you have clarifying questions for the user that will help you perform your task - in which case, feel free to ask that question. \n\nExamples for when to output `::SKIP_COMPLETION::`:\n- If the user asks you to let them know when a reservation opens up at Cotogna at a specific time, and you find out that there is still no reservation available\n- If the user asks you to let them know when they have a new email but there are no new emails since your last run","personalized_task_card_read_timeout_seconds":0.225,"fiber_sync_suggestable_connectors_to_workspace":false},"is_device_based":false,"passed":true},"216490582":{"name":"216490582","rule_id":"default","secondary_exposures":[],"version":4,"id_type":"userID","value