s/940901.f94d1ee18d.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/24015.793876b3f3.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/220362.96995562cf.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/380772.8745275d19.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/18110.c576370915.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/724666.30afaa25f3.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/275810.507df0f256.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/877124.8eb9d515a2.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/288755.e2736945dd.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/58112.98f3480e34.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/352316.13b17f3696.css"><link rel="stylesheet" type="text/css" href="./bobguardian_task05_check_agent_progress_summary_files/581729.db5bc5e909.css"></head><body style="--font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px;"><script nonce="a0e680c1-4b76-4d96-85a8-27eb87b916b8">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
