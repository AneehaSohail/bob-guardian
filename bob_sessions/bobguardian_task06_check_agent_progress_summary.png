.ͼ3 .cm-searchMatch-selected {background-color: #ff00ff8a;}
.ͼw .cm-panels.cm-panels-top:has(.cm-text-file-search-panel) {position: absolute; inset: 0 0 auto; z-index: 10; box-sizing: border-box; display: flex; justify-content: flex-end; padding: 12px; pointer-events: none; background: transparent; border: none;}
