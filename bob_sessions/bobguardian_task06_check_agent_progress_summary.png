"type":"ch_vat","placeholder":"CHE-123.456.789 MWST","country_label":"Switzerland","format":"([Cc][Hh][Ee])[\\. \\-]?(\\d{3})[\\. \\-]?(\\d{3})[\\. \\-]?(\\d{3}) ?([Mm][Ww][Ss][Tt]|[Tt][Vv][Aa]|[Ii][Vv][Aa])","replacement_string":"\\1-\\2.\\3.\\4 \\5","region":"EEA-GB-CH","description":"Switzerland VAT number"},"cy_vat":{"country_label":"Cyprus","placeholder":"CY12345678Z","region":"EEA-GB-CH","stripe_type":"eu_vat","type":"cy_vat","country":"CY","description":"European VAT number","supported":true,"verifiable":true,"format":"CY[0-9]{8}[A-Z]","reverse_charge":true},"my_itn":{"placeholder":"C 1234567890","description":"Malaysian ITN","verifiable":false,"replacement_string":"\\1 \\2","reverse_charge":true,"type":"my_itn","format":"([A-Z]{1,2}) ?([0-9]{10})","region":"MY","supported":false,"stripe_type":"my_itn","country":"MY","country_label":"Malaysia"},"lv_vat":{"supported":true,"description":"European VAT number","verifiable":true,"format":"LV[0-9]{11}","country_label":"Latvia","placeholder":"LV12345678912","country":"LV","type":"lv_vat","stripe_type":"eu_vat","region":"EEA-GB-CH","reverse_charge":true},"ru_kpp":{"country_label":"Russia","placeholder":"123456789","supported":true,"verifiable":false,"country":"RU","stripe_type":"ru_kpp","type":"ru_kpp","format":"[0-9]{9}","region":"RU","reverse_charge":true,"description":"Russian KPP"},"tz_vat":{"country":"TZ","country_label":"Tanzania","placeholder":"12345678A","supported":true,"verifiable":false,"format":"[0-9]{8}[A-Z]","description":"Tanzania VAT Number","region":"TZ","reverse_charge":true,"type":"tz_vat","stripe_type":"tz_vat"},"li_vat":{"supported":true,"format":"[0-9]{5}","placeholder":"12345","stripe_type":"li_vat","description":"Liechtensteinian VAT number","country":"LI","region":"EEA-GB-CH","country_label":"Liechtenstein","reverse_charge":true,"verifiable":false,"type":"li_vat"},"ie_vat":{"country":"IE","verifiable":true,"region":"EEA-GB-CH","country_label":"Ireland","format":"IE([0-9]{7}[A-Z]{1,2}|[0-9][A-