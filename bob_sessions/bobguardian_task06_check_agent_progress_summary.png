"country_label":"Singapore","reverse_charge":true,"stripe_type":"sg_uen","type":"sg_uen","format":"([0-9]{8}[A-Z]|[0-9]{4}[0-9]{5}[A-Z]|F(000|   )[0-9]{5}[A-Z]|[ST][0-9]{2}[A-Z]{2}[0-9]{4}[A-Z])","country":"SG","verifiable":false,"description":"Singaporean UEN","supported":false},"ru_inn":{"stripe_type":"ru_inn","type":"ru_inn","country_label":"Russia","format":"[0-9]{10}","region":"RU","reverse_charge":true,"placeholder":"1234567891","verifiable":false,"country":"RU","description":"Russian INN","supported":true},"bg_vat":{"placeholder":"BG0123456789","format":"BG[0-9]{9,10}","type":"bg_vat","description":"European VAT number","region":"EEA-GB-CH","supported":true,"country":"BG","stripe_type":"eu_vat","verifiable":true,"country_label":"Bulgaria","reverse_charge":true},"jp_rn":{"country":"JP","region":"JP","type":"jp_rn","stripe_type":"jp_rn","placeholder":"12345","reverse_charge":true,"supported":false,"country_label":"Japan","verifiable":false,"format":"[0-9]{5}","description":"Japanese Registered Foreign Businesses Number"},"ca_qst":{"verifiable":false,"country_label":"Canada","description":"Canadian QST number (Québec)","placeholder":"1234567890TQ1234","country":"CA","type":"ca_qst","format":"([0-9]{10}TQ[0-9]{4}|[0-9]{9}[A-Z]{2}[0-9]{4}|[0-9]{9,10}|NR[0-9]{8})","stripe_type":"ca_qst","supported":true,"reverse_charge":false,"region":"CA"},"kr_brn":{"type":"kr_brn","reverse_charge":true,"stripe_type":"kr_brn","verifiable":false,"country_label":"South Korea","country":"KR","region":"KR","supported":true,"replacement_string":"\\1-\\2-\\3","placeholder":"123-45-67890","description":"Korean BRN","format":"([0-9]{3})-?([0-9]{2})-?([0-9]{5})"},"fi_vat":{"format":"FI[0-9]{8}","description":"European VAT number","reverse_charge":true,"placeholder":"FI12345678","region":"EEA-GB-CH","country":"FI","type":"fi_vat","stripe_type":"eu_vat","verifiable":true,"country_label":"Finland","supported":true},"ca_pst_mb":{"country":"CA","country_label":"Canada","stripe_type":"ca_pst_mb","reverse_charge":false,"region":"CA","verifiable":false,"type":"ca_pst_mb","replacement_string":"\\1-\\2","format":"([0-9]{6})-?([0-9])","description":"Canadian PST number (Manitoba)","placeholder":"123456-7","supported":true},"ge_vat":{"country":"GE","region":"GE","reverse_charge":true,"supported":true,"description":"Georgian VAT","verifiable":false,"placeholder":"123456789","stripe_type":"ge_vat","type":"ge_vat","format":"([0-9]{9}|[0-9]{11})","country_label":"Georgia"},"ua_vat":{"format":"([0-9]{8,10}|[0-9]{12})","verifiable":false,"reverse_charge":true,"supported":true,"stripe_type":"ua_vat","placeholder":"123456789","type":"ua_vat","country":"UA","region":"UA","description":"Ukrainian VAT","country_label":"Ukraine"},"cz_vat":{"type":"cz_vat","description":"European VAT number","stripe_type":"eu_vat","supported":true,"country":"CZ","region":"EEA-GB-CH","verifiable":true,"country_label":"Czech Republic","format":"CZ[0-9]{8,10}","placeholder":"CZ1234567890","reverse_charge":true},"ke_pin":{"format":"[A-Z][0-9]{9}[A-Z]","type":"ke_pin","reverse_charge":false,"placeholder":"P000111111A","supported":true,"country_label":"Kenya","stripe_type":"ke_pin","region":"KE","verifiable":false,"description":"Kenya Revenue Authority Personal Identification Number","country":"KE"},"kz_bin":{"country_label":"Kazakhstan","region":"KZ","format":"[0-9]{12}","type":"kz_bin","placeholder":"123456789012","country":"KZ","stripe_type":"kz_bin","supported":true,"verifiable":false,"description":"Kazakhstan Business Identification Number","reverse_charge":true},"ae_trn":{"reverse_charge":true,"country_label":"United Arab Emirates","description":"United Arab Emirates TRN","country":"AE","region":"AE","placeholder":"123456789012345","type":"ae_trn","verifiable":false,"stripe_type":"ae_trn","supported":true,"format":"[0-9]{15}"},"li_uid":{"country":"LI","region":"EEA-GB-CH","placeholder":"CHE123456789","description":"Liechtensteinian UID number","reverse_charge":true,"supported":false,"verifia